# Server
PORT=8000
NODE_ENV=development
# Comma-separated list of allowed browser origins (not needed when the API is served from the same Vercel domain)
CORS_ORIGIN=http://localhost:5173

# MongoDB connection string. The database name defaults to "Hospital" if the URI has none.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net

# Auth (use long random strings)
ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRY=7d

# Roles allowed to self-register from the sign-up page
SIGNUP_ROLES=Manager,Pantry

# Optional: image uploads. Without these, uploads are skipped and records save without a photo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
